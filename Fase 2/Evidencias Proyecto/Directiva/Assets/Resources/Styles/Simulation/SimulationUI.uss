/* One transparent UI Toolkit panel in front of the 3D camera. */
.sim-ui-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(238, 242, 248);
}
.sim-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.sim-hud {
    display: none;
}
.sim-controls-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    min-height: 43px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.sim-controls-cluster {
    position: relative;
    flex-direction: row;
    align-items: center;
}
.sim-controls {
    flex-direction: row;
    align-items: center;
    min-height: 43px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgba(23, 30, 43, 0.90);
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
}
.sim-control-button {
    min-width: 44px;
    height: 30px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-width: 1px;
    border-color: rgb(81, 101, 128);
    border-radius: 5px;
    background-color: rgb(46, 58, 77);
    color: rgb(246, 248, 253);
    -unity-text-align: middle-center;
    font-size: 13px;
}
.sim-play-slot {
    position: relative;
    flex-direction: row;
    align-items: center;
}
.sim-play-disabled-hover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.sim-control-button:disabled {
    opacity: 0.4;
}
.sim-control-button:hover, .sim-menu-button:hover, .sim-editor-header-button:hover,
.sim-editor-tab:hover {
    background-color: rgb(67, 100, 142);
}
.sim-control-button.sim-selected {
    background-color: rgb(36, 105, 157);
    border-color: rgb(105, 173, 234);
}
.sim-control-separator {
    width: 1px;
    height: 24px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(81, 101, 128);
}
.sim-status {
    position: absolute;
    left: 100%;
    top: 12px;
    margin-left: 14px;
    color: rgb(188, 201, 219);
    -unity-text-align: middle-left;
    font-size: 14px;
    white-space: nowrap;
}
/* One centered HUD strip: Editor | match stats | Levels. Free space at the
   screen edges disappears before the stats and buttons need to shrink. Equal
   widths for both buttons keep the match stats centered on the viewport. */
.sim-top-info-row {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 14px;
    height: 50px;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}
.sim-editor-tab {
    width: 160px;
    min-width: 128px;
    min-height: 50px;
    height: 50px;
    margin-right: 8px;
    flex-shrink: 1;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(23, 30, 43, 0.90);
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
    color: rgb(244, 247, 253);
    font-size: 17px;
    -unity-text-align: middle-center;
}
.sim-editor-tab.sim-editor-tab-active {
    border-color: rgb(105, 173, 234);
    background-color: rgba(36, 74, 106, 0.96);
}
.sim-editor-pane {
    position: absolute;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: visible;
    background-color: rgba(18, 22, 29, 0.97);
    border-width: 1px;
    border-color: rgb(83, 110, 145);
    border-radius: 8px;
}
.sim-editor-pane.sim-editor-fullscreen {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(18, 22, 29, 0.98);
}
.sim-editor-header {
    min-height: 40px;
    height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(32, 41, 55);
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 106, 128);
}
.sim-editor-header-button {
    height: 27px;
    margin-left: 5px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(47, 60, 81);
    border-width: 1px;
    border-color: rgb(91, 112, 144);
    border-radius: 5px;
    color: rgb(245, 248, 251);
}
.sim-editor-header-button {
    width: 34px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}
.sim-editor-mount {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}
.sim-editor-resize {
    position: absolute;
    width: 8px;
    right: 0;
    top: 40px;
    bottom: 0;
    background-color: rgba(83, 101, 126, 0.70);
}
.sim-editor-resize:hover, .sim-editor-resize.sim-resizing {
    background-color: rgb(102, 169, 239);
}

/* The Levels button is a sibling of the stats, not a floating overlay. */
.sim-menu-button {
    width: 160px;
    min-width: 128px;
    min-height: 50px;
    height: 50px;
    margin-left: 8px;
    flex-shrink: 1;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
    background-color: rgba(23, 30, 43, 0.90);
    color: rgb(245, 246, 250);
    font-size: 17px;
    -unity-text-align: middle-center;
}

/* Compact Nexus assignment panel: the main HUD/editor paints above it. */
.sim-nexus-program-panel {
    position: absolute;
    width: 430px;
    padding-top: 11px;
    padding-bottom: 12px;
    padding-left: 13px;
    padding-right: 13px;
    background-color: rgba(23, 30, 43, 0.97);
    border-width: 1px;
    border-color: rgb(96, 137, 180);
    border-radius: 9px;
    color: rgb(238, 242, 248);
}
.sim-nexus-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.sim-nexus-panel-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(245, 249, 255);
}
.sim-nexus-panel-close {
    width: 25px;
    height: 24px;
    flex-shrink: 0;
    background-color: rgb(46, 71, 105);
    color: rgb(245, 248, 251);
    border-width: 1px;
    border-color: rgb(96, 137, 180);
    border-radius: 4px;
}
.sim-nexus-panel-close:hover { background-color: rgb(67, 100, 142); }
.sim-nexus-panel-warning {
    white-space: normal;
    font-size: 11px;
    margin-bottom: 8px;
    color: rgb(255, 216, 104);
}
.sim-nexus-panel-row {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    margin-top: 3px;
}
.sim-nexus-panel-field-label {
    width: 146px;
    min-width: 146px;
    flex-shrink: 0;
    margin-right: 9px;
    white-space: nowrap;
    font-size: 12px;
    color: rgb(232, 239, 248);
}
.sim-nexus-panel-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 34px;
    min-height: 34px;
    color: rgb(244, 249, 255);
    font-size: 12px;
}
/* No internal BaseField label: the left column owns the only visible label. */
.sim-nexus-panel-dropdown .unity-base-field__label { display: none; }
.sim-nexus-panel-dropdown .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 34px;
    min-height: 34px;
    padding-top: 0;
    padding-bottom: 0;
}
/* Popup input has its own default light theme; style it explicitly. */
.sim-nexus-panel-dropdown .unity-base-popup-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 34px;
    height: 34px;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 9px;
    padding-right: 5px;
    background-color: rgb(39, 53, 74);
    color: rgb(244, 249, 255);
    border-width: 1px;
    border-color: rgb(99, 133, 169);
    border-radius: 4px;
}
.sim-nexus-panel-dropdown .unity-base-popup-field__input:hover {
    background-color: rgb(51, 72, 101);
    border-color: rgb(131, 174, 220);
}
.sim-nexus-panel-dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
    color: rgb(244, 249, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.sim-nexus-panel-status {
    white-space: normal;
    font-size: 11px;
    margin-top: 7px;
    color: rgb(186, 215, 192);
}
.sim-nexus-panel-status.sim-nexus-panel-error { color: rgb(255, 155, 155); }

.sim-nexus-panel-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(211, 227, 245);
    align-self: center;
    flex-shrink: 0;
}

/* Readable RTS-style match data panel, 20% thinner than the first pass. */
.sim-match-stats-layer {
    width: 820px;
    max-width: 820px;
    min-width: 0;
    flex-shrink: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 50px;
}
.sim-match-stats {
    width: 100%;
    max-width: 820px;
    min-width: 0;
    min-height: 50px;
    height: 50px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: rgba(87, 112, 140, 0.75);
    border-radius: 8px;
    background-color: rgba(17, 25, 36, 0.90);
}
.sim-match-stat {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 6px;
    padding-right: 6px;
    white-space: nowrap;
}
.sim-match-stat-caption {
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 16px;
    color: rgb(205, 215, 229);
}
.sim-match-stat-blue {
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(83, 170, 255);
}
.sim-match-stat-red {
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 107, 111);
}
.sim-match-stat-separator {
    flex-shrink: 0;
    margin-left: 7px;
    margin-right: 7px;
    font-size: 16px;
    color: rgb(184, 198, 218);
}

.sim-match-stat-time {
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 14px;
}
.sim-match-stat-time-value {
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(231, 235, 242);
}

/* Runtime HUD tooltips use the same look as the code editor's tooltips.
   UI Toolkit's built-in VisualElement.tooltip is Editor-only. */
.sim-overlay .directiva-tooltip {
    position: absolute;
    max-width: 320px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(38, 41, 47);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(92, 99, 111);
    border-bottom-color: rgb(92, 99, 111);
    border-left-color: rgb(92, 99, 111);
    border-right-color: rgb(92, 99, 111);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.sim-overlay .directiva-tooltip-label {
    color: rgb(244, 246, 250);
    white-space: normal;
    -unity-text-align: middle-left;
}

/* Keep all three panels in the same horizontal row at compact widths.
   Smaller type in the stats lets the center shrink after outside margins have
   been used, without moving Editor/Levels above the statistics. */
.sim-ui-root.sim-hud-stacked .sim-top-info-row {
    left: 10px;
    right: 10px;
    top: 10px;
    height: 50px;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}
.sim-ui-root.sim-hud-stacked .sim-editor-tab {
    width: 148px;
    min-width: 116px;
    height: 50px;
    min-height: 50px;
    margin-right: 8px;
    padding-left: 9px;
    padding-right: 9px;
    font-size: 15px;
}
.sim-ui-root.sim-hud-stacked .sim-match-stats-layer {
    width: 820px;
    max-width: 820px;
    min-height: 50px;
    height: 50px;
    flex-grow: 0;
    flex-shrink: 1;
}
.sim-ui-root.sim-hud-stacked .sim-match-stats {
    width: 100%;
    max-width: 100%;
    min-height: 50px;
    height: 50px;
    padding-left: 4px;
    padding-right: 4px;
}
.sim-ui-root.sim-hud-stacked .sim-match-stat {
    padding-left: 2px;
    padding-right: 2px;
}
.sim-ui-root.sim-hud-stacked .sim-match-stat-caption {
    font-size: 12px;
    margin-right: 3px;
}
.sim-ui-root.sim-hud-stacked .sim-match-stat-blue,
.sim-ui-root.sim-hud-stacked .sim-match-stat-red,
.sim-ui-root.sim-hud-stacked .sim-match-stat-time-value { font-size: 14px; }
.sim-ui-root.sim-hud-stacked .sim-match-stat-separator {
    font-size: 12px;
    margin-left: 3px;
    margin-right: 3px;
}
.sim-ui-root.sim-hud-stacked .sim-match-stat-time { padding-left: 3px; }
.sim-ui-root.sim-hud-stacked .sim-menu-button {
    width: 148px;
    min-width: 116px;
    height: 50px;
    min-height: 50px;
    font-size: 15px;
}

/* Very narrow panels: match data reflows into two rows INSIDE its panel.
   Both adjacent buttons stretch to that same height, keeping the top edges
   and bottoms perfectly aligned. No extra HUD row is introduced. */
.sim-ui-root.sim-hud-narrow .sim-top-info-row { height: 80px; }
.sim-ui-root.sim-hud-narrow .sim-editor-tab {
    width: 112px;
    min-width: 100px;
    height: 80px;
    min-height: 80px;
    margin-right: 6px;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 13px;
}
.sim-ui-root.sim-hud-narrow .sim-menu-button {
    width: 112px;
    min-width: 100px;
    height: 80px;
    min-height: 80px;
    margin-left: 6px;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 13px;
}
.sim-ui-root.sim-hud-narrow .sim-match-stats-layer,
.sim-ui-root.sim-hud-narrow .sim-match-stats {
    height: 80px;
    min-height: 80px;
}
.sim-ui-root.sim-hud-narrow .sim-match-stats { flex-wrap: wrap; }
.sim-ui-root.sim-hud-narrow .sim-match-stat {
    width: 50%;
    height: 37px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
}
.sim-ui-root.sim-hud-narrow .sim-status {
    left: 0;
    top: -18px;
    margin-left: 0;
    font-size: 11px;
}
.sim-ui-root.sim-hud-narrow .sim-controls-row { bottom: 8px; }
.sim-ui-root.sim-hud-narrow .sim-control-button {
    min-width: 35px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 3px;
    padding-right: 3px;
}
.sim-ui-root.sim-hud-narrow .sim-control-separator {
    margin-left: 4px;
    margin-right: 4px;
}

/* On true high-DPI / 4K-sized panels, use more physical pixels for the HUD.
   If PanelSettings already scales a 4K screen to 1920 panel units, these
   overrides will not activate (avoiding double scaling). */
.sim-ui-root.sim-hud-large .sim-top-info-row {
    top: 20px;
    left: 24px;
    right: 24px;
    height: 72px;
}
.sim-ui-root.sim-hud-large .sim-editor-tab {
    width: 224px;
    min-width: 180px;
    min-height: 72px;
    height: 72px;
    margin-right: 14px;
    font-size: 24px;
}
.sim-ui-root.sim-hud-large .sim-match-stats-layer {
    width: 1180px;
    max-width: 1180px;
    min-height: 72px;
}
.sim-ui-root.sim-hud-large .sim-match-stats {
    max-width: 1180px;
    height: 72px;
    min-height: 72px;
    padding-left: 18px;
    padding-right: 18px;
}
.sim-ui-root.sim-hud-large .sim-match-stat-caption { font-size: 23px; }
.sim-ui-root.sim-hud-large .sim-match-stat-blue,
.sim-ui-root.sim-hud-large .sim-match-stat-red,
.sim-ui-root.sim-hud-large .sim-match-stat-time-value { font-size: 26px; }
.sim-ui-root.sim-hud-large .sim-match-stat-separator { font-size: 23px; }
.sim-ui-root.sim-hud-large .sim-controls-row { bottom: 16px; }
.sim-ui-root.sim-hud-large .sim-controls { min-height: 58px; }
.sim-ui-root.sim-hud-large .sim-control-button {
    min-width: 61px;
    height: 43px;
    font-size: 18px;
}
.sim-ui-root.sim-hud-large .sim-status { top: 17px; font-size: 19px; }
.sim-ui-root.sim-hud-large .sim-menu-button {
    width: 224px;
    min-width: 180px;
    min-height: 72px;
    height: 72px;
    margin-left: 14px;
    font-size: 24px;
}

/* Finished-match screen. Use the slate palette of the main menu rather than
   a separate blue-toned card style. Blue/red numbers and the outcome colors
   remain semantic: they identify the sides and the match result. */
.sim-results-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(11, 17, 26, 0.82);
}
.sim-results-card {
    width: 675px;
    height: auto;
    max-width: 94%;
    max-height: 91%;
    min-height: 0;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 1;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 22px;
    padding-bottom: 20px;
    background-color: rgba(27, 33, 45, 0.97);
    border-width: 1px;
    border-color: rgb(91, 109, 143);
    border-radius: 14px;
}
.sim-results-outcome {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
    flex-shrink: 0;
}
.sim-results-level {
    color: rgb(147, 157, 177);
    font-size: 19px;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 15px;
    flex-shrink: 0;
}
.sim-results-victory { color: rgb(95, 220, 124); }
.sim-results-defeat { color: rgb(242, 103, 107); }
.sim-results-draw { color: rgb(240, 205, 94); }
/* No flex-grow: 1 here: let the scroll view take its natural content height.
   Only shrink it if the card hits its max-height on a small display. */
.sim-results-scroll {
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 1;
}
/* Same narrow, quiet scrollbar as the menu options panel. It is Auto-hidden
   when the whole results content fits in the viewport. */
.sim-results-scroll .unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    background-color: rgba(24, 27, 32, 0.6);
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 2px;
    padding-bottom: 2px;
}
.sim-results-scroll .unity-scroller__low-button,
.sim-results-scroll .unity-scroller__high-button { display: none; }
.sim-results-scroll .unity-scroller__slider {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
}
.sim-results-scroll .unity-base-slider__tracker {
    background-color: rgba(31, 35, 41, 0.7);
    border-width: 0;
    border-radius: 3px;
}
.sim-results-scroll .unity-base-slider__dragger {
    background-color: rgb(91, 98, 110);
    border-width: 0;
    border-radius: 3px;
}
.sim-results-scroll .unity-base-slider__dragger:hover,
.sim-results-scroll .unity-base-slider__dragger:active {
    background-color: rgb(126, 139, 157);
}
.sim-results-metrics { margin-bottom: 12px; }
.sim-results-metric-headings {
    min-height: 27px;
    border-bottom-color: rgba(106, 127, 152, 0.46);
}
.sim-results-metric-row {
    flex-direction: row;
    align-items: center;
    min-height: 33px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(106, 127, 152, 0.25);
}
.sim-results-metric-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(231, 236, 244);
    font-size: 16px;
    white-space: normal;
}
.sim-results-metric-value {
    width: 114px;
    min-width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    font-size: 17px;
}
.sim-results-value-blue { color: rgb(83, 170, 255); }
.sim-results-value-red { color: rgb(255, 107, 111); }
.sim-results-elapsed-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 37px;
    margin-top: 5px;
    padding-left: 8px;
    padding-right: 8px;
}
.sim-results-elapsed-name {
    font-size: 16px;
    color: rgb(231, 236, 244);
}
.sim-results-time-value {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(255, 255, 255);
}
.sim-results-metric-heading {
    font-size: 14px;
    -unity-font-style: bold;
}
.sim-results-stars {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 11px;
    margin-bottom: 15px;
}
.sim-results-star-slot {
    width: 78px;
    height: 72px;
    margin-left: 13px;
    margin-right: 13px;
    justify-content: center;
    align-items: center;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(91, 109, 143, 0.45);
    background-color: rgba(49, 61, 83, 0.52);
}
.sim-results-star-slot:hover { background-color: rgba(70, 91, 124, 0.78); }
.sim-results-star-icon {
    width: 58px;
    height: 58px;
}
.sim-results-actions {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 11px;
}
.sim-results-action {
    height: 44px;
    min-width: 205px;
    margin: 5px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 1px;
    border-color: rgb(91, 109, 143);
    border-radius: 9px;
    background-color: rgb(49, 61, 83);
    color: rgb(232, 240, 252);
    font-size: 16px;
}
.sim-results-action:hover { background-color: rgb(70, 91, 124); }
.sim-results-action:active { background-color: rgb(43, 110, 171); }
.sim-results-action-primary { background-color: rgb(42, 107, 169); }
.sim-results-action-primary:hover { background-color: rgb(43, 110, 171); }

/* Confirm leaving the match from the top-right Levels button. The slate
   palette is intentionally shared with the results dialog and main menu. */
.sim-leave-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(11, 17, 26, 0.82);
}
.sim-leave-card {
    width: 510px;
    max-width: 92%;
    max-height: 90%;
    min-width: 0;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 23px;
    padding-bottom: 22px;
    background-color: rgba(27, 33, 45, 0.98);
    border-width: 1px;
    border-color: rgb(91, 109, 143);
    border-radius: 12px;
}
.sim-leave-title {
    color: rgb(235, 240, 248);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}
.sim-leave-message {
    color: rgb(187, 198, 217);
    white-space: normal;
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-bottom: 21px;
}
.sim-leave-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.sim-leave-button {
    min-width: 142px;
    min-height: 38px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(49, 61, 83);
    color: rgb(240, 243, 249);
    border-width: 1px;
    border-color: rgb(91, 109, 143);
    border-radius: 6px;
    font-size: 15px;
}
.sim-leave-button:hover { background-color: rgb(70, 91, 124); }
.sim-leave-button-primary { background-color: rgb(42, 107, 169); }
.sim-leave-button-primary:hover { background-color: rgb(43, 110, 171); }
