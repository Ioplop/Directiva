/* One transparent UI Toolkit panel in front of the 3D camera. */
.sim-ui-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(238, 242, 248);
}
.sim-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.sim-hud {
    position: absolute;
    top: 14px;
    left: 18px;
    right: 18px;
    min-height: 45px;
    flex-direction: row;
    align-items: center;
}
.sim-controls {
    flex-direction: row;
    align-items: center;
    min-height: 43px;
    padding-left: 7px;
    padding-right: 7px;
    margin-left: 12px;
    background-color: rgba(23, 30, 43, 0.90);
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
}
.sim-control-button {
    min-width: 44px;
    height: 30px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-width: 1px;
    border-color: rgb(81, 101, 128);
    border-radius: 5px;
    background-color: rgb(46, 58, 77);
    color: rgb(246, 248, 253);
    -unity-text-align: middle-center;
    font-size: 13px;
}
.sim-play-slot {
    position: relative;
    flex-direction: row;
    align-items: center;
}
.sim-play-disabled-hover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.sim-control-button:disabled {
    opacity: 0.4;
}
.sim-control-button:hover, .sim-menu-button:hover, .sim-editor-header-button:hover,
.sim-editor-tab:hover {
    background-color: rgb(67, 100, 142);
}
.sim-control-button.sim-selected {
    background-color: rgb(36, 105, 157);
    border-color: rgb(105, 173, 234);
}
.sim-control-separator {
    width: 1px;
    height: 24px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(81, 101, 128);
}
.sim-status {
    margin-left: 14px;
    color: rgb(188, 201, 219);
    -unity-text-align: middle-left;
}
.sim-menu-button {
    height: 43px;
    min-width: 94px;
    margin-left: auto;
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
    background-color: rgba(23, 30, 43, 0.90);
    color: rgb(245, 246, 250);
}
/* Editor toggle occupies the former level-title slot in the global HUD.
   It stays in flow in all three editor modes; no floating side tab. */
.sim-editor-tab {
    width: 160px;
    min-width: 160px;
    height: 43px;
    flex-shrink: 0;
    padding: 4px;
    background-color: rgba(23, 30, 43, 0.90);
    border-width: 1px;
    border-color: rgb(85, 107, 136);
    border-radius: 8px;
    color: rgb(244, 247, 253);
    -unity-text-align: middle-center;
}
.sim-editor-tab.sim-editor-tab-active {
    border-color: rgb(105, 173, 234);
    background-color: rgba(36, 74, 106, 0.96);
}
.sim-editor-pane {
    position: absolute;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: visible;
    background-color: rgba(18, 22, 29, 0.97);
    border-width: 1px;
    border-color: rgb(83, 110, 145);
    border-radius: 8px;
}
.sim-editor-pane.sim-editor-fullscreen {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(18, 22, 29, 0.98);
}
.sim-editor-header {
    min-height: 40px;
    height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(32, 41, 55);
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 106, 128);
}
.sim-editor-header-button {
    height: 27px;
    margin-left: 5px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(47, 60, 81);
    border-width: 1px;
    border-color: rgb(91, 112, 144);
    border-radius: 5px;
    color: rgb(245, 248, 251);
}
.sim-editor-header-button {
    width: 34px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}
.sim-editor-mount {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}
.sim-editor-resize {
    position: absolute;
    width: 8px;
    right: 0;
    top: 40px;
    bottom: 0;
    background-color: rgba(83, 101, 126, 0.70);
}
.sim-editor-resize:hover, .sim-editor-resize.sim-resizing {
    background-color: rgb(102, 169, 239);
}

/* Global HUD and navigation remain visible above the fullscreen editor. */
.sim-menu-button {
    position: absolute;
    right: 18px;
    top: 14px;
    margin-left: 0;
    height: 42px;
    min-width: 112px;
    padding-left: 12px;
    padding-right: 12px;
}
.sim-hud { right: 150px; }

/* Compact Nexus assignment panel: the main HUD/editor paints above it. */
.sim-nexus-program-panel {
    position: absolute;
    width: 430px;
    padding-top: 11px;
    padding-bottom: 12px;
    padding-left: 13px;
    padding-right: 13px;
    background-color: rgba(23, 30, 43, 0.97);
    border-width: 1px;
    border-color: rgb(96, 137, 180);
    border-radius: 9px;
    color: rgb(238, 242, 248);
}
.sim-nexus-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.sim-nexus-panel-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(245, 249, 255);
}
.sim-nexus-panel-close {
    width: 25px;
    height: 24px;
    flex-shrink: 0;
    background-color: rgb(46, 71, 105);
    color: rgb(245, 248, 251);
    border-width: 1px;
    border-color: rgb(96, 137, 180);
    border-radius: 4px;
}
.sim-nexus-panel-close:hover { background-color: rgb(67, 100, 142); }
.sim-nexus-panel-warning {
    white-space: normal;
    font-size: 11px;
    margin-bottom: 8px;
    color: rgb(255, 216, 104);
}
.sim-nexus-panel-row {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    margin-top: 3px;
}
.sim-nexus-panel-field-label {
    width: 146px;
    min-width: 146px;
    flex-shrink: 0;
    margin-right: 9px;
    white-space: nowrap;
    font-size: 12px;
    color: rgb(232, 239, 248);
}
.sim-nexus-panel-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 34px;
    min-height: 34px;
    color: rgb(244, 249, 255);
    font-size: 12px;
}
/* No internal BaseField label: the left column owns the only visible label. */
.sim-nexus-panel-dropdown .unity-base-field__label { display: none; }
.sim-nexus-panel-dropdown .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 34px;
    min-height: 34px;
    padding-top: 0;
    padding-bottom: 0;
}
/* Popup input has its own default light theme; style it explicitly. */
.sim-nexus-panel-dropdown .unity-base-popup-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 34px;
    height: 34px;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 9px;
    padding-right: 5px;
    background-color: rgb(39, 53, 74);
    color: rgb(244, 249, 255);
    border-width: 1px;
    border-color: rgb(99, 133, 169);
    border-radius: 4px;
}
.sim-nexus-panel-dropdown .unity-base-popup-field__input:hover {
    background-color: rgb(51, 72, 101);
    border-color: rgb(131, 174, 220);
}
.sim-nexus-panel-dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
    color: rgb(244, 249, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.sim-nexus-panel-status {
    white-space: normal;
    font-size: 11px;
    margin-top: 7px;
    color: rgb(186, 215, 192);
}
.sim-nexus-panel-status.sim-nexus-panel-error { color: rgb(255, 155, 155); }

.sim-nexus-panel-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(211, 227, 245);
    align-self: center;
    flex-shrink: 0;
}

/* Read-only replay-style scoreboard. Lower paint priority than the editor. */
.sim-match-stats-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7px;
    height: 31px;
    flex-direction: row;
    justify-content: center;
}
.sim-match-stats {
    width: 100%;
    max-width: 790px;
    height: 31px;
    margin-left: 10px;
    margin-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgba(87, 112, 140, 0.75);
    border-radius: 6px;
    background-color: rgba(17, 25, 36, 0.88);
}
.sim-match-stat {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
}
.sim-match-stat-caption {
    flex-shrink: 0;
    margin-right: 5px;
    font-size: 11px;
    color: rgb(205, 215, 229);
}
.sim-match-stat-blue {
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(83, 170, 255);
}
.sim-match-stat-red {
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 107, 111);
}
.sim-match-stat-separator {
    flex-shrink: 0;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 11px;
    color: rgb(184, 198, 218);
}

/* The fourth HUD metric shows simulated time remaining in the level. */
.sim-match-stat-time {
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 10px;
}
.sim-match-stat-time-value {
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(231, 235, 242);
}

/* Runtime HUD tooltips use the same look as the code editor's tooltips.
   UI Toolkit's built-in VisualElement.tooltip is Editor-only. */
.sim-overlay .directiva-tooltip {
    position: absolute;
    max-width: 320px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(38, 41, 47);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(92, 99, 111);
    border-bottom-color: rgb(92, 99, 111);
    border-left-color: rgb(92, 99, 111);
    border-right-color: rgb(92, 99, 111);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.sim-overlay .directiva-tooltip-label {
    color: rgb(244, 246, 250);
    white-space: normal;
    -unity-text-align: middle-left;
}
