# Local variables belong to the current function.
# global is private to a VM; shared belongs to the entire team.

global calls = 0
shared team_calls = 0

def main():
    # Only this VM remembers calls.
    calls += 1
    # The entire team shares team_calls.
    team_calls += 1
    message = "Calls"
    print(message, calls, team_calls)
