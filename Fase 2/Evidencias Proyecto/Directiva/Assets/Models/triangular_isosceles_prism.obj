# Simple triangular isosceles prism for Unity
# Base rests on Y=0, length along Z, flat-shaded with explicit normals
v -0.500000 0.000000 -0.500000
v 0.500000 0.000000 -0.500000
v 0.000000 0.750000 -0.500000
v -0.500000 0.000000 0.500000
v 0.500000 0.000000 0.500000
v 0.000000 0.750000 0.500000
vn 0.000000 0.000000 -1.000000
vn 0.000000 0.000000 1.000000
vn 0.000000 -1.000000 0.000000
vn 0.832050 0.554700 0.000000
vn -0.832050 0.554700 0.000000
s off
f 1//1 3//1 2//1
f 4//2 5//2 6//2
f 1//3 2//3 5//3
f 1//3 5//3 4//3
f 2//4 3//4 6//4
f 2//4 6//4 5//4
f 3//5 1//5 4//5
f 3//5 4//5 6//5
