# Square pyramid - outward-facing winding, flat face normals
# Dimensions: 1 x 1 base, height 1 (Y-up); bottom center at origin.
o SquarePyramid
s off

v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
v  0.0 1.0  0.0

# Outward-facing unit normals: base, -Z, +X, +Z, -X
vn  0.000000 -1.000000  0.000000
vn  0.000000  0.447214 -0.894427
vn  0.894427  0.447214  0.000000
vn  0.000000  0.447214  0.894427
vn -0.894427  0.447214  0.000000

# Base (normal points downward)
f 1//1 2//1 3//1
f 1//1 3//1 4//1

# Four triangular sides (flat-shaded)
f 1//2 5//2 2//2
f 2//3 5//3 3//3
f 3//4 5//4 4//4
f 4//5 5//5 1//5
