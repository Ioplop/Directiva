# Simple regular octahedron for Unity
# Centered at origin, flat-shaded with explicit normals
v 1.000000 0.000000 0.000000
v -1.000000 0.000000 0.000000
v 0.000000 1.000000 0.000000
v 0.000000 -1.000000 0.000000
v 0.000000 0.000000 1.000000
v 0.000000 0.000000 -1.000000
vn 0.577350 0.577350 0.577350
vn -0.577350 0.577350 0.577350
vn -0.577350 0.577350 -0.577350
vn 0.577350 0.577350 -0.577350
vn 0.577350 -0.577350 0.577350
vn -0.577350 -0.577350 0.577350
vn -0.577350 -0.577350 -0.577350
vn 0.577350 -0.577350 -0.577350
s off
f 1//1 3//1 5//1
f 5//2 3//2 2//2
f 2//3 3//3 6//3
f 6//4 3//4 1//4
f 5//5 4//5 1//5
f 2//6 4//6 5//6
f 6//7 4//7 2//7
f 1//8 4//8 6//8
